# /etc/k8s-cloudkms-plugin/env, one per node.
#
# Paste this node's entry from `terraform output -json plugin_args` here.
# Nothing in this file is secret: the only credential is the key inside the TPM.
PLUGIN_ARGS="--key-uri=projects/my-project/locations/us-central1/keyRings/kubernetes/cryptoKeys/secrets --wif-provider=projects/123456789/locations/global/workloadIdentityPools/k8s-cloudkms-plugin/providers/node-1 --jwt-issuer=https://tpm.k8s-cloudkms-plugin.internal --jwt-subject=node-1 --impersonate-service-account=k8s-cloudkms-plugin@my-project.iam.gserviceaccount.com"
