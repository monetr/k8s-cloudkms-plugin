# /etc/k8s-cloudkms-plugin/env, one per node.
#
# Paste this node's entry from `terraform output -json plugin_args` (see
# terraform/) here. Nothing in this file is secret: the only credential is the
# key inside the TPM.
#
# If the key is bound to boot state, the flags must match the policy it was
# created with (see "Binding the key to boot state" in the README). plugin_args
# includes them when tpm_key_pcrs / tpm_pcr_public_key are set; this example
# is for a key bound to PCR 7 and to signed PCR 11 policies.
PLUGIN_ARGS="--key-uri=projects/my-project/locations/us-central1/keyRings/kubernetes/cryptoKeys/secrets --wif-provider=projects/123456789/locations/global/workloadIdentityPools/k8s-cloudkms-plugin/providers/node-1 --jwt-issuer=https://tpm.k8s-cloudkms-plugin.internal --jwt-subject=node-1 --tpm-key-pcrs=7 --tpm-pcr-public-key=/etc/k8s-cloudkms-plugin/pcr-public-key.pem"
